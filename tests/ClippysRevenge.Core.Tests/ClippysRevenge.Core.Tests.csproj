<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Windows: the live Outlook tests (Live/) compile the App's Outlook*.cs sources (SPEC §3, §15).
         Other OSes: net10.0 with Core only; Live/ is not compiled. -->
    <TargetFramework Condition="'$(OS)' == 'Windows_NT'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(OS)' != 'Windows_NT'">net10.0</TargetFramework>
    <ClippyLive Condition="'$(OS)' == 'Windows_NT'">true</ClippyLive>
    <!-- System.Drawing for TrayBadgeRenderer (Windows build only). -->
    <UseWindowsForms Condition="'$(ClippyLive)' == 'true'">true</UseWindowsForms>
    <OutputType>Exe</OutputType>            <!-- required by xunit v3 -->
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ClippysRevenge.Core\ClippysRevenge.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(ClippyLive)' != 'true'">
    <Compile Remove="Live/**" />
  </ItemGroup>

  <ItemGroup Condition="'$(ClippyLive)' == 'true'">
    <!-- Compile-time only, embedded like in the App. -->
    <PackageReference Include="Microsoft.Office.Interop.Outlook" Version="15.0.4797.1004" ExcludeAssets="runtime" />
    <!-- Explicit list of App sources. Never add the launcher, the entry point, the MCP tools or the tray
         (except TrayBadgeRenderer.cs, which needs only System.Drawing). -->
    <Compile Include="..\..\src\ClippysRevenge.App\Tray\TrayBadgeRenderer.cs"   Link="AppLinked\TrayBadgeRenderer.cs" />
    <Compile Include="..\..\src\ClippysRevenge.App\OutlookWorker.cs"            Link="AppLinked\OutlookWorker.cs" />
    <Compile Include="..\..\src\ClippysRevenge.App\OutlookStores.cs"            Link="AppLinked\OutlookStores.cs" />
    <Compile Include="..\..\src\ClippysRevenge.App\OutlookMail.cs"              Link="AppLinked\OutlookMail.cs" />
    <Compile Include="..\..\src\ClippysRevenge.App\OutlookMail.Attachments.cs"  Link="AppLinked\OutlookMail.Attachments.cs" />
    <Compile Include="..\..\src\ClippysRevenge.App\OutlookMail.Drafts.cs"       Link="AppLinked\OutlookMail.Drafts.cs" />
    <Compile Include="..\..\src\ClippysRevenge.App\OutlookMail.Reply.cs"        Link="AppLinked\OutlookMail.Reply.cs" />
    <Compile Include="..\..\src\ClippysRevenge.App\OutlookMailSource.cs"        Link="AppLinked\OutlookMailSource.cs" />
    <Compile Include="..\..\src\ClippysRevenge.App\OutlookDraftWriter.cs"       Link="AppLinked\OutlookDraftWriter.cs" />
    <Compile Include="..\..\src\ClippysRevenge.App\OutlookReplyDraftWriter.cs"  Link="AppLinked\OutlookReplyDraftWriter.cs" />
    <Compile Include="..\..\src\ClippysRevenge.App\OutlookCalendar.Events.cs"   Link="AppLinked\OutlookCalendar.Events.cs" />
    <Compile Include="..\..\src\ClippysRevenge.App\OutlookCalendar.FreeBusy.cs" Link="AppLinked\OutlookCalendar.FreeBusy.cs" />
    <Compile Include="..\..\src\ClippysRevenge.App\OutlookCalendar.Invites.cs"  Link="AppLinked\OutlookCalendar.Invites.cs" />
    <Compile Include="..\..\src\ClippysRevenge.App\OutlookCalendar.DraftInvites.cs" Link="AppLinked\OutlookCalendar.DraftInvites.cs" />
    <Compile Include="..\..\src\ClippysRevenge.App\OutlookCalendar.OpenInvite.cs" Link="AppLinked\OutlookCalendar.OpenInvite.cs" />
    <Compile Include="..\..\src\ClippysRevenge.App\OutlookFreeBusySource.cs"    Link="AppLinked\OutlookFreeBusySource.cs" />
    <Compile Include="..\..\src\ClippysRevenge.App\SignatureRegistry.cs"        Link="AppLinked\SignatureRegistry.cs" />
    <Compile Include="..\..\src\ClippysRevenge.App\OutlookAiMailbox.cs"         Link="AppLinked\OutlookAiMailbox.cs" />
  </ItemGroup>

  <!-- Keep the existing tests free of the WinForms global usings (Timer etc. would become ambiguous). -->
  <Target Name="ClippyDropWinFormsUsings" BeforeTargets="GenerateGlobalUsings" Condition="'$(ClippyLive)' == 'true'">
    <ItemGroup>
      <Using Remove="System.Windows.Forms" />
      <Using Remove="System.Drawing" />
    </ItemGroup>
  </Target>

  <!-- Same embed target as the App csproj. -->
  <Target Name="EmbedOutlookInteropTypes" AfterTargets="ResolveAssemblyReferences" Condition="'$(ClippyLive)' == 'true'">
    <ItemGroup>
      <ReferencePath Condition="'%(FileName)' == 'Microsoft.Office.Interop.Outlook'">
        <EmbedInteropTypes>true</EmbedInteropTypes>
      </ReferencePath>
    </ItemGroup>
  </Target>
</Project>
