<Project>
  <!-- Single source of the product version. Bumping it on main publishes a
       GitHub release v$(Version) (see .github/workflows/release.yml). -->
  <PropertyGroup>
    <Version>0.0.2</Version>
    <Product>Clippy's Revenge</Product>
    <Company>Dirk Petersen</Company>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
